import pandas as pd


produtos_atualizado = pd.read_csv("NARA_csv/produtos_atualizado.csv", sep=",")
produto_adicional = pd.read_csv("NARA_csv/produto_adicional.csv", sep=";")


produtos_final = pd.concat([produtos_atualizado, produto_adicional], ignore_index=True)


produtos_final.to_csv("NARA_csv/produtos_final.csv", sep=",", index=False)

print("✅ Novo arquivo criado em 'NARA_csv/produtos_final.csv'")
